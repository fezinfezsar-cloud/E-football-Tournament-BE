# Server Configuration (Render automatically sets PORT in production)
PORT=3000
NODE_ENV=production

# MongoDB Connection String
# PRODUCTION (Render): Set 'MONGODB_URI' in Render's Environment settings with your MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/efootball_db?retryWrites=true&w=majority
# LOCAL DEVELOPMENT: Uses your local MongoDB or automatically falls back to in-memory database
MONGODB_URI=mongodb://127.0.0.1:27017/efootball_db

# JWT Secret for Session Tokens (use a strong 64+ char random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Tournament System Admin Credentials (used for logging into /admin/login)
ADMIN_EMAIL=admin@techfest.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Production Netlify Frontend URL for CORS (comma-separated if multiple domains)
# Example: https://mini-mayhem.netlify.app
FRONTEND_URL=https://your-tournament-app.netlify.app

# Cloudinary Configuration (required for payment & game-plan screenshot uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
